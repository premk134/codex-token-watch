def normalized_cli_args() -> list[str]:
    """Allow the convenient legacy-looking --codex://threads/... spelling."""
    normalized = []
    for argument in sys.argv[1:]:
        if argument.startswith("--codex://threads/"):
            normalized.append(argument[2:])
        else:
            normalized.append(argument)
    return normalized


def thread_reference(value: str) -> str:
    match = re.fullmatch(r"codex://threads/([0-9a-fA-F-]+)", value)
    return match.group(1) if match else value


def last_value(value: str) -> int:
    try:
        count = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("use a positive number") from error
    if count < 1:
        raise argparse.ArgumentTypeError("must be at least 1")
    return count


def since_value(value: str) -> tuple[int, str]:
    match = re.fullmatch(r"([1-9][0-9]*)([mhd])", value.lower())
    if not match:
        raise argparse.ArgumentTypeError("use a duration such as 6h, 24h, or 3d")
    amount = int(match.group(1))
    unit = match.group(2)
    multiplier = {"m": 60, "h": 3_600, "d": 86_400}[unit]
    return amount * multiplier, f"{amount}{unit}"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Print local Codex token usage and prompt-cache diagnostics."
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {VERSION}",
    )
    parser.add_argument(
        "target",
        nargs="?",
        help=(
            "Task ID, unique ID prefix, or codex://threads/<thread-id>; "
            "omit with --last, --since, or --zero-cache for a cross-task report"
        ),
    )
    parser.add_argument(
        "--last",
        type=last_value,
        metavar="N",
        help="Show the latest N turns in one task, or across tasks when no task is given",
    )
    parser.add_argument(
        "--zero-cache",
        action="store_true",
        help=(
            "Show model calls with zero cached input, excluding compaction resets; "
            "omit the task to scan all tasks active in the last 24 hours"
        ),
    )
    parser.add_argument(
        "--since",
        type=since_value,
        metavar="DURATION",
        help=(
            "Cross-task turn or cache-miss window such as 6h, 24h, or 3d"
        ),
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable terminal colors",
    )
    parser.add_argument(
        "--hide-luna",
        action="store_true",
        help="Hide Luna-only rows while keeping their usage in totals",
    )
    args = parser.parse_args(normalized_cli_args())
    if args.target is not None:
        args.target = thread_reference(args.target)
        if not re.fullmatch(r"[0-9a-fA-F-]{4,}", args.target):
            parser.error(
                "target must be a task ID, ID prefix, or codex://threads/<thread-id>"
            )
        if args.since is not None:
            parser.error("--since is only available when the task is omitted")
    else:
        if args.last is not None and args.since is not None:
            parser.error("use either --last or --since for a cross-task report, not both")
        if args.zero_cache:
            if args.last is not None:
                parser.error("--last requires a task when used with --zero-cache")
            if args.since is None:
                args.since = (86_400, "24h")
        elif args.last is None and args.since is None:
            parser.error("provide a task, --last N, --since DURATION, or --zero-cache")
    return args


def codex_dir() -> Path:
    configured = os.environ.get("CODEX_HOME")
    return Path(configured).expanduser() if configured else Path.home() / ".codex"


def version_key(path: Path) -> tuple[int, int]:
    match = re.search(r"_(\d+)\.sqlite$", path.name)
    return (int(match.group(1)) if match else -1, path.stat().st_mtime_ns)


def readonly_connection(path: Path) -> sqlite3.Connection:
    uri = f"file:{quote(str(path), safe='/')}?mode=ro"
    connection = sqlite3.connect(uri, uri=True, timeout=0.2)
    connection.execute("PRAGMA query_only = ON")
    connection.execute("PRAGMA busy_timeout = 200")
    return connection


def task_databases(base: Path) -> list[Path]:
    databases = sorted(base.glob("state_*.sqlite"), key=version_key, reverse=True)
    if not databases:
        raise RuntimeError(f"No Codex state database found under {base}")
    return databases


def validate_task_row(row: tuple[str, str, str]) -> tuple[str, Path, str]:
    resolved_id, rollout_path, title = row
    path = Path(rollout_path).expanduser()
    if not path.is_file():
        raise RuntimeError(f"Rollout file does not exist: {path}")
    return resolved_id, path, title or "Untitled task"


def find_task(databases: list[Path], selector: str) -> tuple[str, Path, str] | None:
    matches: dict[str, tuple[str, str, str]] = {}
    for database in databases:
        try:
            with readonly_connection(database) as connection:
                rows = connection.execute(
                    """
                    SELECT id, rollout_path, COALESCE(NULLIF(name, ''), title)
                    FROM threads
                    WHERE id = ? OR id LIKE ?
                    """,
                    (selector, f"{selector}%"),
                ).fetchall()
        except sqlite3.Error:
            continue
        for row in rows:
            matches.setdefault(row[0], row)

    if not matches:
        return None
    if len(matches) > 1:
        choices = ", ".join(sorted(thread_id[:12] for thread_id in matches))
        raise RuntimeError(f"Task ID prefix is ambiguous ({choices}); provide more characters")
    return validate_task_row(next(iter(matches.values())))


def resolve_task(base: Path, selector: str) -> tuple[str, Path, str]:
    task = find_task(task_databases(base), selector)
    if task:
        return task
    raise RuntimeError(f"Codex task not found: {selector}")


def ordered_tasks(
    base: Path, cutoff: datetime | None = None
) -> list[tuple[int, str, Path, str]]:
    """Return deduplicated tasks ordered by their latest recorded update."""
    matches: dict[str, tuple[int, str, str, str]] = {}
    for database in task_databases(base):
        try:
            with readonly_connection(database) as connection:
                if cutoff is None:
                    rows = connection.execute(
                        """
                        SELECT id, rollout_path, COALESCE(NULLIF(name, ''), title), updated_at
                        FROM threads
                        ORDER BY updated_at DESC
                        """
                    ).fetchall()
                else:
                    rows = connection.execute(
                        """
                        SELECT id, rollout_path, COALESCE(NULLIF(name, ''), title), updated_at
                        FROM threads
                        WHERE updated_at >= ?
                        ORDER BY updated_at DESC
                        """,
                        (int(cutoff.timestamp()),),
                    ).fetchall()
        except sqlite3.Error:
            continue
        for thread_id, rollout_path, title, updated_at in rows:
            candidate = (int(updated_at), thread_id, rollout_path, title or "Untitled task")
            current = matches.get(thread_id)
            if current is None or candidate[0] > current[0]:
                matches[thread_id] = candidate

    tasks = []
    for updated_at, thread_id, rollout_path, title in sorted(
        matches.values(), reverse=True
    ):
        path = Path(rollout_path).expanduser()
        if path.is_file():
            tasks.append((updated_at, thread_id, path, title))
    return tasks


def recent_tasks(base: Path, cutoff: datetime) -> list[tuple[str, Path, str]]:
    """Return deduplicated tasks updated inside the requested rolling window."""
    return [
        (thread_id, path, title)
        for _updated_at, thread_id, path, title in ordered_tasks(base, cutoff)
    ]


def user_message(payload: dict) -> str | None:
    if payload.get("type") != "message" or payload.get("role") != "user":
        return None
    content = payload.get("content")
    if not isinstance(content, list):
        return None
    pieces = []
    for item in content:
        if not isinstance(item, dict):
            continue
        value = item.get("text")
        if item.get("type") in {"input_text", "text"} and isinstance(value, str):
            pieces.append(value)
    return " ".join(pieces) or None


def synthetic_context_message(value: str) -> bool:
    """Exclude Codex-injected context blocks from the user-visible turn label."""
    stripped = value.lstrip()
    return stripped.startswith(
        (
            "<recommended_plugins>",
            "<app-context>",
            "<environment_context>",
            "# AGENTS.md instructions",
            "<skill>",
        )
    )


def parsed_time(timestamp: str | None) -> datetime | None:
    if not timestamp:
        return None
    try:
        return datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
    except ValueError:
        return None


def integer(mapping: dict, key: str) -> int:
    value = mapping.get(key, 0)
    return value if isinstance(value, int) else 0


def scan_rollout(path: Path) -> tuple[list[dict], list[dict]]:
    turns: dict[str, dict] = {}
    turn_order: list[str] = []
    calls: list[dict] = []
    active_turn: str | None = None
    compaction_pending = False

    def ensure_turn(turn_id: str) -> dict:
        if turn_id not in turns:
            turns[turn_id] = {
                "id": turn_id,
                "prompt": None,
                "status": None,
                "started_time": None,
                "status_time": None,
                "latest_record": None,
                "calls": [],
                "model": None,
                "effort": None,
                "next_turn_cache_percent": None,
            }
            turn_order.append(turn_id)
        return turns[turn_id]

    with path.open(errors="replace") as handle:
        for line in handle:
            try:
                record = json.loads(line)
            except (json.JSONDecodeError, UnicodeDecodeError):
                continue
            record_type = record.get("type")
            if record_type == "compacted":
                compaction_pending = True
                continue
            payload = record.get("payload")
            if not isinstance(payload, dict):
                continue

            if record_type == "turn_context":
                turn_id = payload.get("turn_id")
                if turn_id:
                    active_turn = turn_id
                    turn = ensure_turn(turn_id)
                    turn["model"] = payload.get("model")
                    turn["effort"] = payload.get("effort")
                continue

            if record_type == "response_item":
                text = user_message(payload)
                if active_turn and text and not synthetic_context_message(text):
                    turn = ensure_turn(active_turn)
                    if not turn["prompt"]:
                        turn["prompt"] = text
                continue

            if record_type == "token_usage_record":
                turn_id = payload.get("turn_id")
                usage = payload.get("usage")
                if not turn_id or not isinstance(usage, dict):
                    continue
                input_tokens = usage.get("input_tokens")
                cached_tokens = usage.get("cached_input_tokens")
                if not isinstance(input_tokens, int) or input_tokens <= 0:
                    continue
                if not isinstance(cached_tokens, int):
                    continue
                turn = ensure_turn(turn_id)
                call = {
                    "turn_id": turn_id,
                    "timestamp": record.get("timestamp"),
                    "time": parsed_time(record.get("timestamp")),
                    "usage": usage,
                    "index": len(turn["calls"]) + 1,
                    "gap_seconds": None,
                    "after_compaction": compaction_pending,
                    "model": turn["model"],
                    "effort": turn["effort"],
                }
                turn["calls"].append(call)
                calls.append(call)
                compaction_pending = False
                if isinstance(payload.get("turn_token_usage"), dict):
                    turn["latest_record"] = record
                continue

            if record_type == "event_msg":
                event_type = payload.get("type")
                turn_id = payload.get("turn_id")
                if event_type == "task_started" and turn_id:
                    active_turn = turn_id
                    turn = ensure_turn(turn_id)
                    turn["started_time"] = record.get("timestamp")
                elif event_type in {"task_complete", "turn_aborted"} and turn_id:
                    turn = ensure_turn(turn_id)
                    turn["status"] = (
                        "completed" if event_type == "task_complete" else "aborted"
                    )
                    turn["status_time"] = record.get("timestamp")
                    if active_turn == turn_id:
                        active_turn = None

    previous = None
    for call in calls:
        if previous and call["time"] and previous["time"]:
            call["gap_seconds"] = (call["time"] - previous["time"]).total_seconds()
        previous = call

    ordered_turns = [turns[turn_id] for turn_id in turn_order]
    for turn in ordered_turns:
        for key in ("model", "effort"):
            known = {call[key] for call in turn["calls"] if call.get(key)}
            if turn.get(key):
                known.add(turn[key])
            if len(known) == 1:
                inferred = next(iter(known))
                for call in turn["calls"]:
                    if not call.get(key):
                        call[key] = inferred
        if turn["status"]:
            continue
        if turn["id"] == active_turn:
            turn["status"] = "running snapshot"
        else:
            turn["status"] = "latest snapshot"
        if turn["latest_record"]:
            turn["status_time"] = turn["latest_record"].get("timestamp")

    reported_turns = [turn for turn in ordered_turns if turn["latest_record"]]
    for turn, following in zip(reported_turns, reported_turns[1:]):
        usage = following["latest_record"].get("payload", {}).get(
            "turn_token_usage", {}
        )
        next_input = integer(usage, "input_tokens")
        next_cached = integer(usage, "cached_input_tokens")
        if next_input:
            turn["next_turn_cache_percent"] = next_cached / next_input * 100.0
    return ordered_turns, calls


def local_time(timestamp: str | None) -> str:
    parsed = parsed_time(timestamp)
    if parsed:
        return parsed.astimezone().strftime("%b %d %H:%M:%S")
    return "unknown time"


def compact_local_time(timestamp: str | None) -> str:
    parsed = parsed_time(timestamp)
    if parsed:
        return parsed.astimezone().strftime("%b %d %H:%M")
    return "unknown"


def short_text(value: str, limit: int) -> str:
    one_line = " ".join(value.split())
    if len(one_line) <= limit:
        return one_line
    return one_line[: limit - 1].rstrip() + "…"


def format_count(value: int) -> str:
    if value < 1_000:
        return f"{value:,}"
    thousands = value / 1_000
    if thousands < 10:
        return f"{thousands:.1f}K"
    return f"{thousands:,.0f}K"


def pricing_for_model(model: str | None) -> dict[str, float] | None:
    if not model:
        return None
    if model in API_PRICING:
        return API_PRICING[model]
    for prefix in ("gpt-6-astra", "gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"):
        if model.startswith(prefix + "-"):
            return API_PRICING[prefix]
    return None


def model_display(model: str) -> str:
    if model in MODEL_LABELS:
        return MODEL_LABELS[model]
    for prefix in ("gpt-6-astra", "gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna"):
        if model.startswith(prefix + "-"):
            return MODEL_LABELS[prefix]
    return model


def luna_model(model: str | None) -> bool:
    return bool(
        model
        and (model == "gpt-5.6-luna" or model.startswith("gpt-5.6-luna-"))
    )


def luna_only_turn(turn: dict) -> bool:
    models = {call.get("model") for call in turn.get("calls", []) if call.get("model")}
    if not models and turn.get("model"):
        models.add(turn["model"])
    return bool(models) and all(luna_model(model) for model in models)


