def call_api_cost(call: dict) -> float | None:
    rates = pricing_for_model(call.get("model"))
    if rates is None:
        return None

    usage = call["usage"]
    input_tokens = integer(usage, "input_tokens")
    cached_tokens = min(input_tokens, integer(usage, "cached_input_tokens"))
    writable_tokens = max(0, input_tokens - cached_tokens)
    cache_write_tokens = min(
        writable_tokens, integer(usage, "cache_write_input_tokens")
    )
    fresh_tokens = max(0, input_tokens - cached_tokens - cache_write_tokens)
    output_tokens = integer(usage, "output_tokens")

    input_multiplier = 2.0 if input_tokens > LONG_CONTEXT_THRESHOLD else 1.0
    output_multiplier = 1.5 if input_tokens > LONG_CONTEXT_THRESHOLD else 1.0
    return (
        fresh_tokens * rates["input"] * input_multiplier
        + cached_tokens * rates["cached"] * input_multiplier
        + cache_write_tokens * rates["cache_write"] * input_multiplier
        + output_tokens * rates["output"] * output_multiplier
    ) / 1_000_000


def turn_api_cost(turn: dict) -> float | None:
    record = turn.get("latest_record")
    if not record:
        return None
    expected = record.get("payload", {}).get("turn_token_usage", {})
    calls = turn.get("calls", [])
    if not calls:
        return None

    # Per-call data is required to apply the >272K request multiplier correctly.
    # Refuse to display a partial estimate if older call data is unavailable.
    for key in ("input_tokens", "cached_input_tokens", "output_tokens"):
        if sum(integer(call["usage"], key) for call in calls) != integer(expected, key):
            return None

    costs = [call_api_cost(call) for call in calls]
    if any(cost is None for cost in costs):
        return None
    return sum(cost for cost in costs if cost is not None)


def thread_api_cost(turns: list[dict], usage: dict) -> float | None:
    calls = [call for turn in turns for call in turn.get("calls", [])]
    costs = [call_api_cost(call) for call in calls]
    if any(cost is None for cost in costs):
        return None

    keys = (
        "input_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "output_tokens",
    )
    residual = {
        key: integer(usage, key) - sum(integer(call["usage"], key) for call in calls)
        for key in keys
    }
    if any(value < 0 for value in residual.values()):
        return None
    if not any(residual.values()):
        return sum(cost for cost in costs if cost is not None)

    # A continued rollout can inherit a small usage baseline. It is safe to
    # estimate only when the missing input cannot conceal a >272K request and
    # every visible call used the same model.
    models = {call.get("model") for call in calls if call.get("model")}
    if residual["input_tokens"] > LONG_CONTEXT_THRESHOLD or len(models) != 1:
        return None
    inherited_call = {"model": next(iter(models)), "usage": residual}
    inherited_cost = call_api_cost(inherited_call)
    if inherited_cost is None:
        return None
    return sum(cost for cost in costs if cost is not None) + inherited_cost


def format_usd(value: float | None) -> str:
    if value is None:
        return "—"
    if value < 0.01:
        return f"${value:.4f}"
    return f"${value:,.2f}"


def turn_setting(turn: dict, key: str) -> str:
    values = {call.get(key) for call in turn.get("calls", []) if call.get(key)}
    if not values and turn.get(key):
        values.add(turn[key])
    if len(values) > 1:
        return "mixed"
    return next(iter(values), "—")


def thread_setting(turns: list[dict], key: str) -> str:
    values = {
        call.get(key)
        for turn in turns
        for call in turn.get("calls", [])
        if call.get(key)
    }
    if len(values) > 1:
        return "mixed"
    return next(iter(values), "—")


def latest_thread_turn(turns: list[dict]) -> dict:
    return max(
        turns,
        key=lambda turn: integer(
            turn["latest_record"].get("payload", {}).get("thread_token_usage", {}),
            "total_tokens",
        ),
    )


def task_bounds(turns: list[dict]) -> tuple[datetime | None, datetime | None]:
    bounds = [turn_bounds(turn) for turn in turns]
    starts = [start for start, _end in bounds if start is not None]
    ends = [end for _start, end in bounds if end is not None]
    if not starts or not ends:
        return None, None
    return min(starts), max(ends)


def task_period(turns: list[dict]) -> str:
    start, end = task_bounds(turns)
    if start is None or end is None:
        return "unknown"
    local_start = start.astimezone()
    local_end = end.astimezone()
    if local_start.date() == local_end.date():
        return f"{local_start:%b %d}, {local_start:%H:%M}–{local_end:%H:%M}"
    return f"{local_start:%b %d %H:%M}–{local_end:%b %d %H:%M}"


def single_task_date(turns: list[dict]) -> bool:
    start, end = task_bounds(turns)
    return bool(
        start is not None
        and end is not None
        and start.astimezone().date() == end.astimezone().date()
    )


def table_time(timestamp: str | None, time_only: bool) -> str:
    parsed = parsed_time(timestamp)
    if not parsed:
        return "unknown"
    local = parsed.astimezone()
    return local.strftime("%H:%M" if time_only else "%b %d %H:%M")


def turn_change_map(turns: list[dict]) -> dict[str, str]:
    changes = {}
    previous_model = None
    previous_effort = None
    for turn in turns:
        model = turn_setting(turn, "model")
        effort = turn_setting(turn, "effort")

        # Some resumed/continued turns contain usage but omit turn-context
        # metadata. Treat those missing values as unchanged instead of showing
        # a pair of misleading transitions through —/—.
        current_model = previous_model if model == "—" else model
        current_effort = previous_effort if effort == "—" else effort
        pieces = []
        if (
            previous_model is not None
            and previous_effort is not None
            and current_model is not None
            and current_effort is not None
            and (current_model, current_effort) != (
            previous_model,
            previous_effort,
            )
        ):
            before = f"{model_display(previous_model)}/{previous_effort}"
            after = f"{model_display(current_model)}/{current_effort}"
            pieces.append(f"{before}→{after}")
        if turn["status"] == "aborted":
            pieces.append("aborted")
        elif turn["status"] == "running snapshot":
            pieces.append("running")
        changes[turn["id"]] = "; ".join(pieces)
        if current_model is not None:
            previous_model = current_model
        if current_effort is not None:
            previous_effort = current_effort
    return changes


def format_gap(seconds: float | None) -> str:
    if seconds is None:
        return "history unavailable"
    seconds = max(0, int(round(seconds)))
    if seconds < 60:
        return f"{seconds}s"
    minutes, second = divmod(seconds, 60)
    if minutes < 60:
        return f"{minutes}m {second}s"
    hours, minute = divmod(minutes, 60)
    if hours < 24:
        return f"{hours}h {minute}m"
    days, hour = divmod(hours, 24)
    return f"{days}d {hour}h"


def turn_bounds(turn: dict) -> tuple[datetime | None, datetime | None]:
    call_times = [call["time"] for call in turn.get("calls", []) if call.get("time")]
    start = parsed_time(turn.get("started_time"))
    if start is None and call_times:
        start = min(call_times)
    end = parsed_time(turn.get("status_time"))
    if end is None and call_times:
        end = max(call_times)
    return start, end


def turn_duration(turn: dict) -> str:
    start, end = turn_bounds(turn)
    if start is None or end is None:
        return "—"
    seconds = max(0.0, (end - start).total_seconds())
    return f"{int((seconds + 30) // 60)}m"


def thread_duration(turns: list[dict]) -> str:
    bounds = [turn_bounds(turn) for turn in turns]
    starts = [start for start, _end in bounds if start is not None]
    ends = [end for _start, end in bounds if end is not None]
    if not starts or not ends:
        return "—"
    seconds = max(0.0, (max(ends) - min(starts)).total_seconds())
    return f"{int((seconds + 30) // 60)}m"


def paint(value: str, style: str | None) -> str:
    if not USE_COLOR or not style:
        return value
    return f"\033[{ANSI[style]}m{value}\033[0m"


def cache_style(percent: float) -> str:
    if percent >= 95.0:
        return "green"
    if percent >= 90.0:
        return "yellow"
    return "bold_red" if percent == 0 else "red"


def change_style(value: str) -> str:
    if "aborted" in value:
        return "bold_red"
    if "running" in value:
        return "bold_yellow"
    if "→" in value:
        return "bold_cyan"
    return "gray"


