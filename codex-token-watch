def print_table(headers: list[str], rows: list[dict], right: set[int] | None = None) -> None:
    right = right or set()
    widths = [len(header) for header in headers]
    for row in rows:
        for index, value in enumerate(row["cells"]):
            widths[index] = max(widths[index], len(value))

    header = "  ".join(
        paint(
            value.rjust(widths[index]) if index in right else value.ljust(widths[index]),
            header_style(value),
        )
        for index, value in enumerate(headers)
    )
    print(header)
    print(paint("  ".join("─" * width for width in widths), "gray"))
    for row in rows:
        if row.get("separator_before"):
            print(paint("  ".join("─" * width for width in widths), "gray"))
        parts = []
        for index, value in enumerate(row["cells"]):
            padded = value.rjust(widths[index]) if index in right else value.ljust(widths[index])
            parts.append(paint(padded, row["styles"][index]))
        print("  ".join(parts))


