def collect_recent_turns(
    base: Path,
    last: int | None,
    window: tuple[int, str] | None,
) -> tuple[list[tuple], int]:
    now = datetime.now().astimezone()
    cutoff = now - timedelta(seconds=window[0]) if window is not None else None
    search_cutoffs = [cutoff] if cutoff is not None else [
        now - timedelta(hours=1),
        now - timedelta(hours=6),
        now - timedelta(days=1),
        now - timedelta(days=7),
        now - timedelta(days=30),
        now - timedelta(days=365),
        datetime.fromtimestamp(0).astimezone(),
    ]
    selected = []
    tasks_scanned = 0
    scanned_threads = set()
    finished = False
    for search_cutoff in search_cutoffs:
        for updated_at, thread_id, rollout, title in ordered_tasks(
            base, search_cutoff
        ):
            if thread_id in scanned_threads:
                continue
            scanned_threads.add(thread_id)
            try:
                turns, _calls = scan_rollout(rollout)
            except OSError:
                continue
            tasks_scanned += 1
            changes = turn_change_map(turns)
            for turn in turns:
                if not turn["latest_record"]:
                    continue
                timestamp = parsed_time(turn["status_time"])
                if timestamp is None or (cutoff is not None and timestamp < cutoff):
                    continue
                selected.append(
                    (
                        timestamp,
                        thread_id,
                        title,
                        turn,
                        changes.get(turn["id"], ""),
                    )
                )

            if last is not None and len(selected) >= last:
                boundary = sorted(selected, key=lambda item: item[0], reverse=True)[
                    last - 1
                ][0]
                if updated_at < int(boundary.timestamp()):
                    finished = True
                    break
        if finished or window is not None:
            break
        if last is not None and len(selected) >= last:
            boundary = sorted(selected, key=lambda item: item[0], reverse=True)[
                last - 1
            ][0]
            if search_cutoff < boundary:
                break

    selected.sort(key=lambda item: item[0])
    if last is not None:
        selected = selected[-last:]
    return selected, tasks_scanned


