def print_zero_cache(
    turns: list[dict], all_turns: list[dict], hide_luna: bool = False
) -> int:
    total_calls = sum(len(turn["calls"]) for turn in turns)
    misses = [
        (turn, call)
        for turn in turns
        for call in turn["calls"]
        if integer(call["usage"], "cached_input_tokens") == 0
        and not call["after_compaction"]
    ]
    summary_style = "bold_red" if misses else "bold_green"
    print(
        paint("COMPLETE CACHE MISSES", summary_style)
        + f"  {len(misses)} / {total_calls} model calls"
    )
    if not misses:
        return 0

    visible_misses = (
        [(turn, call) for turn, call in misses if not luna_model(call.get("model"))]
        if hide_luna
        else misses
    )
    hidden_count = len(misses) - len(visible_misses)
    if not visible_misses:
        print()
        print(paint("No non-Luna cache misses to display.", "bold_green"))
        print_hidden_luna(hidden_count, "cache-miss row")
        return 0

    headers = [
        "TIME",
        "CALL",
        "GAP",
        "WHERE",
        "INPUT",
        "API EST.",
        "NEXT TURN",
    ]
    rows = []
    prompts = []
    changes = turn_change_map(all_turns)
    row_changes = []
    change_seen = set()
    time_only = single_task_date(all_turns)
    for turn, call in visible_misses:
        boundary = "new turn" if call["index"] == 1 else "same turn"
        next_percent = turn["next_turn_cache_percent"]
        next_value = "—" if next_percent is None else f"{next_percent:.1f}%"
        rows.append(
            {
                "cells": [
                    table_time(call["timestamp"], time_only),
                    f"{call['index']}/{len(turn['calls'])}",
                    format_gap(call["gap_seconds"]),
                    boundary,
                    format_count(integer(call["usage"], "input_tokens")),
                    format_usd(call_api_cost(call)),
                    next_value,
                ],
                "styles": [
                    "gray",
                    "bold_red",
                    "yellow" if (call["gap_seconds"] or 0) < 1800 else "red",
                    "yellow" if boundary == "same turn" else None,
                    "white",
                    "cyan",
                    None if next_percent is None else cache_style(next_percent),
                ],
            }
        )
        prompts.append(turn["prompt"])
        change = changes.get(turn["id"], "") if turn["id"] not in change_seen else ""
        row_changes.append(change)
        change_seen.add(turn["id"])

    show_changes = any(row_changes)
    if show_changes:
        headers.append("CHANGE")
        for row, change in zip(rows, row_changes):
            row["cells"].append(change)
            row["styles"].append(change_style(change))
    right = {1, 4, 5, 6}
    has_prompt_column = add_prompt_column(headers, rows, prompts)
    print_table(headers, rows, right=right)
    miss_turns = [turn for turn, _call in visible_misses]
    if not has_prompt_column and len({turn["id"] for turn in miss_turns}) <= 10:
        print_prompt_legend(miss_turns)
    print_hidden_luna(hidden_count, "cache-miss row")
    return 0


def print_recent_zero_cache(
    base: Path, window: tuple[int, str], hide_luna: bool = False
) -> int:
    seconds, label = window
    cutoff = datetime.now().astimezone() - timedelta(seconds=seconds)
    misses = []
    calls_checked = 0
    tasks_scanned = 0

    for thread_id, rollout, title in recent_tasks(base, cutoff):
        try:
            turns, calls = scan_rollout(rollout)
        except OSError:
            continue
        changes = turn_change_map(turns)
        window_calls = [
            call
            for call in calls
            if call.get("time") is not None and call["time"] >= cutoff
        ]
        if not window_calls:
            continue
        window_call_ids = {id(call) for call in window_calls}
        tasks_scanned += 1
        calls_checked += len(window_calls)

        for turn in turns:
            for call in turn["calls"]:
                if id(call) not in window_call_ids:
                    continue
                if integer(call["usage"], "cached_input_tokens") != 0:
                    continue
                if call["after_compaction"] or call["gap_seconds"] is None:
                    continue
                misses.append(
                    (
                        call["time"],
                        thread_id,
                        title,
                        turn,
                        call,
                        changes.get(turn["id"], ""),
                    )
                )

    misses.sort(key=lambda item: item[0])
    print(
        paint("CACHE MISSES", "bold_red")
        + paint("  ·  ", "gray")
        + paint(f"LAST {label.upper()}", "bold_white")
    )

    visible_misses = (
        [item for item in misses if not luna_model(item[4].get("model"))]
        if hide_luna
        else misses
    )
    hidden_count = len(misses) - len(visible_misses)

    if visible_misses:
        print()
        headers = [
            "TIME",
            "TASK",
            "MODEL",
            "EFFORT",
            "GAP",
            "WHERE",
            "INPUT",
            "API EST.",
            "NEXT TURN",
            "CHANGE",
        ]
        rows = []
        prompts = []
        change_seen = set()
        for _time, thread_id, title, turn, call, change in visible_misses:
            boundary = "new turn" if call["index"] == 1 else "same turn"
            next_percent = turn["next_turn_cache_percent"]
            next_value = "—" if next_percent is None else f"{next_percent:.1f}%"
            task = f"{short_text(title, 30)} [{thread_id[:8]}]"
            gap_seconds = call["gap_seconds"]
            turn_key = (thread_id, turn["id"])
            change_value = change if turn_key not in change_seen else ""
            change_seen.add(turn_key)
            rows.append(
                {
                    "cells": [
                        table_time(call["timestamp"], False),
                        task,
                        model_display(call.get("model") or "—"),
                        call.get("effort") or "—",
                        format_gap(gap_seconds),
                        boundary,
                        format_count(integer(call["usage"], "input_tokens")),
                        format_usd(call_api_cost(call)),
                        next_value,
                        change_value or "—",
                    ],
                    "styles": [
                        "gray",
                        "white",
                        "violet",
                        "cyan",
                        "bold_red" if gap_seconds < 1_800 else "gray",
                        "bold_red" if boundary == "same turn" else "gray",
                        "white",
                        "cyan",
                        None if next_percent is None else cache_style(next_percent),
                        change_style(change_value),
                    ],
                }
            )
            prompts.append(turn["prompt"])
        has_prompt_column = add_prompt_column(headers, rows, prompts)
        print_table(headers, rows, right={6, 7, 8})
        if not has_prompt_column:
            print_recent_prompt_legend(visible_misses)
        print_hidden_luna(hidden_count, "cache-miss row")
    elif misses:
        print()
        print(paint("No non-Luna cache misses to display.", "bold_green"))
        print_hidden_luna(hidden_count, "cache-miss row")
    else:
        print()
        print(paint("No complete cache misses found.", "bold_green"))

    print()
    miss_label = "miss" if len(misses) == 1 else "misses"
    task_label = "task" if tasks_scanned == 1 else "tasks"
    call_label = "call" if calls_checked == 1 else "calls"
    print(
        paint("SUMMARY", "bold_gray")
        + "  "
        + paint(
            f"{len(misses)} {miss_label}  ·  "
            f"{tasks_scanned} {task_label} scanned  ·  "
            f"{calls_checked} model {call_label} checked",
            "white",
        )
    )
    return 0


def main() -> int:
    global USE_COLOR
    args = parse_args()
    USE_COLOR = sys.stdout.isatty() and not args.no_color and "NO_COLOR" not in os.environ
    if args.target is None:
        try:
            if args.zero_cache:
                return print_recent_zero_cache(
                    codex_dir(), args.since, hide_luna=args.hide_luna
                )
            return print_recent_turns(
                codex_dir(), args.last, args.since, hide_luna=args.hide_luna
            )
        except (RuntimeError, OSError, sqlite3.Error) as error:
            print(f"error: {error}", file=sys.stderr)
            return 1

    try:
        thread_id, rollout, title = resolve_task(codex_dir(), args.target)
        turns, _calls = scan_rollout(rollout)
    except (RuntimeError, OSError, sqlite3.Error) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1

    all_turns = [turn for turn in turns if turn["latest_record"]]
    reports = selected_turns(turns, args.last)
    print_header(title, thread_id)
    if not reports:
        print("No turns with token usage found in this task.")
        return 1
    print_metadata(all_turns)

    if args.zero_cache:
        print()
        return print_zero_cache(reports, all_turns, hide_luna=args.hide_luna)

    print()
    if len(reports) > 1:
        print(
            paint("TURNS", "bold_gray")
            + "  "
            + paint(str(len(reports)), "bold_white")
        )
    print_turns(reports, all_turns, hide_luna=args.hide_luna)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
