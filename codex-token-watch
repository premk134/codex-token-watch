def status_display(status: str) -> tuple[str, str]:
    if status == "completed":
        return "done", "bold_green"
    if status == "aborted":
        return "aborted", "bold_red"
    if status == "running snapshot":
        return "running", "bold_yellow"
    return "snapshot", "bold_sky"


def table_width(headers: list[str], rows: list[dict]) -> int:
    widths = [len(header) for header in headers]
    for row in rows:
        for index, value in enumerate(row["cells"]):
            widths[index] = max(widths[index], len(value))
    return sum(widths) + 2 * (len(widths) - 1)


def add_prompt_column(headers: list[str], rows: list[dict], prompts: list[str | None]) -> bool:
    available = shutil.get_terminal_size(fallback=(120, 24)).columns - table_width(headers, rows) - 2
    if available < 18:
        return False
    width = min(48, available)
    headers.append("PROMPT")
    for row, prompt in zip(rows, prompts):
        row["cells"].append(short_text(prompt or "—", width))
        row["styles"].append("gray")
    return True


