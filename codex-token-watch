def recent_turn_summary(items: list[tuple]) -> dict:
    turns = [item[3] for item in items]
    usages = [
        turn["latest_record"].get("payload", {}).get("turn_token_usage", {})
        for turn in turns
    ]
    input_tokens = sum(integer(usage, "input_tokens") for usage in usages)
    cached_tokens = sum(integer(usage, "cached_input_tokens") for usage in usages)
    total_output = sum(integer(usage, "output_tokens") for usage in usages)
    reasoning = sum(integer(usage, "reasoning_output_tokens") for usage in usages)
    output = max(0, total_output - reasoning)
    cache_percent = cached_tokens / input_tokens * 100.0 if input_tokens else 0.0
    costs = [turn_api_cost(turn) for turn in turns]
    total_cost = (
        None
        if any(cost is None for cost in costs)
        else sum(cost for cost in costs if cost is not None)
    )
    models = {turn_setting(turn, "model") for turn in turns}
    efforts = {turn_setting(turn, "effort") for turn in turns}
    model = next(iter(models)) if len(models) == 1 else "mixed"
    model = model_display(model) if model not in {"—", "mixed"} else model
    effort = next(iter(efforts)) if len(efforts) == 1 else "mixed"
    duration_seconds = 0.0
    for turn in turns:
        start, end = turn_bounds(turn)
        if start is not None and end is not None:
            duration_seconds += max(0.0, (end - start).total_seconds())
    duration = f"{int((duration_seconds + 30) // 60)}m"
    task_count = len({item[1] for item in items})
    return {
        "cells": [
            "ALL",
            f"{task_count} {'task' if task_count == 1 else 'tasks'}",
            format_count(input_tokens),
            f"{cache_percent:.1f}%",
            format_count(output),
            format_count(reasoning),
            format_usd(total_cost),
            model,
            effort,
            str(sum(len(turn["calls"]) for turn in turns)),
            duration,
            "",
        ],
        "styles": [
            "bold_cyan",
            "bold_white",
            "bold_white",
            cache_style(cache_percent),
            "bold_white",
            "bold_gray",
            "bold_cyan",
            "bold_violet",
